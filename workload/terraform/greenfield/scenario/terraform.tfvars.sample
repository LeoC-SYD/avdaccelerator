/*tested on
Terraform v1.4.2
on windows_amd64
+ provider registry.terraform.io/azure/azapi v1.9.0
+ provider registry.terraform.io/hashicorp/azuread v2.25.0
+ provider registry.terraform.io/hashicorp/azurerm v3.44.1
+ provider registry.terraform.io/hashicorp/local v2.2.3
+ provider registry.terraform.io/hashicorp/random v3.3.2
+ provider registry.terraform.io/hashicorp/time v0.8.0
*/

##############  Modify the following variables to match your environment by replacing the values in quotes #####################
scenario_identity          = "aadds"                             # choose aadds, entra_id, or hybrid_ad
device_management          = "none"                              # choose intune or none
fslogix_storage            = "azure_files"                       # choose azure_files or azure_netapp_files
fslogix_auth_mode          = "aadds_smb"                         # choose aadds_smb or entra_id_kerberos
join_method                = "domain_join"                       # domain_join (aadds/hybrid) or entra_join (cloud-only)
avdLocation               = "northeurope"                         # change to your Azure region
# host_location            = "northeurope"                        # optional: region for session hosts (and their RG)
# network_location         = "northeurope"                        # optional: region for VNet/network resources
# log_location             = "northeurope"                        # optional: region for Log Analytics (and its RG)
prefix                    = "syd"                                # change to your prefix 4 characters (letters and numbers only)
local_admin_username      = "localadmin"                          # Your AVD VM local Windows administrator login username (administrator is not allowed)
session_host_sku          = "Standard_D2s_v5"                     # Session host compute
vnet_range                = ["10.15.1.0/24"]                      # change to your cidr for the avd spoke vnet to be created
subnet_range              = ["10.15.1.0/26"]                      # change to your cidr for the avd spoke subnet to be created
pesubnet_range            = ["10.15.1.64/27"]                     # change to your cidr for avd spoke private endpoint subnet to be created
allow_list_ip             = ["90.115.63.18","92.92.163.27"]       # optional for access to browswer resources with private endpoint you can add your IP address to allowlist
dns_servers               = ["10.0.1.6", "168.63.129.16"]         # optional if you want to use your own DNS servers
next_hop_ip               = "10.100.0.4"                          # next hop ip address for route table
aad_group_name            = "GS_AVD_Compta"                       # user group must pre-created on your AD server and sync to Microsoft Entra ID
rdsh_count                = 2                                     # Number of session host vm to deploy
image_name                = "avdImage-win11-23h2-avd-m365"        # custom image name
image_rg                  = "rg-poc-avd-image-resources"          # resource group for custom image and image gallery
gallery_name              = "avdgallery"                          # azure compute gallery name for custom image
hub_vnet                  = "vnet-hub-frcentral-001"              # hub connectivity vnet name 
hub_connectivity_rg       = "rg-hub"                              # hub connectivity subscription network resource group
hub_dns_zone_rg           = "rg-syd-dns-avd-prod-001"             # private DNS zones resource group name
identity_rg               = "rg-syd-id-global-prod-001"           # identity subscription resource group
identity_vnet             = "vnet-syd-net-global-id-prod-001"     # identity subscription vnet name
# Domain join configuration
aadds_domain_name         = "contoso.com"                         # Microsoft Entra Domain Services domain name
aadds_username            = "aaddsadmin"                          # domain join account username
# dc_admin_username       = "aaddsadmin"                          # deprecated; use aadds_username
# aadds_password          = "P@ssw0rd!"                          # optional: provide to use a specific password
aadds_netbios_domain      = "CONTOSO"                             # NetBIOS name of the domain
enable_webauthn           = true                                  # enable WebAuthn redirection
fw_policy                 = "fwpol-hub"                           # firewall policy for AVD assumes that firewall is already deployed in hub subscription
spoke_subscription_id     = "7efe8b9e-79ce-475b-b3bb-94f77f5c544c"   # subscription where AVD resources will be deployed
hub_subscription_id       = "9cccfd92-8356-48f4-8c82-f269fa037dce"   # subscription where hub resources are deployed (If you are using a single subscription for hub and spoke, use the same subscription id as spoke_subscription_id)
identity_subscription_id  = "36759938-be1e-42fc-9da0-4c8422a2c12c"   # subscription where identity resources are deployed (If you are using a single subscription for hub and spoke, use the same subscription id as spoke_subscription_id)
connectivity_subscription_id = "36759938-be1e-42fc-9da0-4c8422a2c12c" # subscription where connectivity resources are deployed
avdshared_subscription_id = "7efe8b9e-79ce-475b-b3bb-94f77f5c544c"   # optional subscription where shared resources are deployed (If you are using a single subscription for hub and spoke, use the same subscription id as spoke_subscription_id)
tenant_id                 = "c05f7306-c76e-493f-8be0-c73c616ead5e"   # your Azure tenant id

offer      = "windows-11"                             # Offer of the image
publisher  = "MicrosoftWindowsDesktop"                # Publisher of the image
sku        = "win11-24h2-avd"                         # SKU of the image

############## Do not modify below this line unless you want to change naming convention#####################
# Resource Groups
rg_shared_name = "shared-resources" #output rg-avd-<Azure Region>-<prefix>-shared-resources
rg_network     = "network"          #rg-avd-<Azure Region>-<prefix>-network
rg_stor        = "storage"          #rg-avd-<Aazure Region>-<prefix>-storage
# rg_fslogix    = "fslogix"         #rg-avd-<Azure Region>-<prefix>-fslogix (optional)
rg_pool        = "pool-compute"     #rg-avd-<Azure Region>-<prefix>-pool-compute
rg_so          = "service-objects"  #rg-avd-<Azure Region>-<prefix>-service-objects
rg_avdi        = "monitoring"       #rg-avd-<Azure Region>-<prefix>-avdi
rg_image_name  = "image-resources"

# Azure Virtual Desktop Objects
## Host Pool Objects
hostpool     = "vdmpool" #vdpool-<azure region>-<prefix> multi-session host pool
personalpool = "vdppool" #vdpool-<azure region>-<prefix> personal host pool
raghostpool  = "vdrpool" #vdpool-<azure region>-<prefix> remote app group host pool

## Workspace Objects
workspace    = "vdmws" #vdmws-<azure region>-<prefix>-<nnn> AVD workspace for multi-session host pool
pworkspace   = "vdpws" #vdpws-<azure region>-<prefix>-<nnn> AVD workspace for personal host pool
ragworkspace = "vdrws" #vdrws-<azure region>-<prefix>-<nnn> AVD workspace for remote app group host pool

## Application Group Objects
pag = "vpag" #AVD personal pool desktop application group
dag = "vdag" #vdag-desktop-<azure region>-<prefix>-<nnn> AVD mulit-session pool desktop application group 
rag = "vrag" #vdag-rapp-<azure region>-<prefix>-<nnn> AVD remote application pool desktop application group

## Diagnostic Settings for AVD Insights
host_pool_log_categories = ["Checkpoint", "Management", "Connection", "HostRegistration", "AgentHealthStatus", "NetworkData", "SessionHostManagement", "ConnectionGraphicsData", "Error"]
dag_log_categories       = ["Checkpoint", "Management", "Error"]
ws_log_categories        = ["Checkpoint", "Management", "Error", "Feed"]

## Scaling Plan Objects
scplan = "scaling-plan" #avd-<location>-<prefix>-scaling-plan

# Network Objects
rt     = "route-avd"  #route-avd-<azure region>-<prefix>-<nnn> Route Table
nsg    = "nsg-avd"    #nsg-avd-<azure region>-<prefix>-<nnn> Network Security Group
vnet   = "vnet-avd"   #vnet-avd-<azure region>-<prefix>-<nnn> Virtual Network
snet   = "snet-avd"   #snet-avd-<azure region>-<prefix>-<nnn> Subnet
pesnet = "pesnet-avd" #snet-avd-<azure region>-<prefix>-<nnn> Private Endpoint Subnet

# BackEnd configuration
state_resource_group_name  = "rg-syd-tf-prod-frc-001"
state_storage_account_name = "stsydtfprod001"
state_container_name       = "tfstate-defaults"
state_key                  = "terraform.tfstate"
